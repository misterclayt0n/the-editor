{
  "name": "@the-editor/default",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "editor": {
    "id": "default",
    "title": "Default Distribution",
    "runtime": "./src/runtime.ts",
    "interaction": "./src/interaction.ts",
    "ui": "./src/ui.tsx",
    "defaultTargets": ["runtime", "interaction", "ui"]
  },
  "scripts": {
    "build": "tsdown src/index.ts src/scratch.ts src/keymaps.ts src/runtime.ts src/interaction.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@the-editor/contracts": "workspace:*",
    "@the-editor/editor": "workspace:*"
  },
  "devDependencies": {
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
