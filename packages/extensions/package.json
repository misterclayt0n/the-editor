{
  "name": "@the-editor/extensions",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts --dts --format esm",
    "dev": "tsdown src/index.ts --dts --format esm --watch",
    "typecheck": "tsgo --noEmit --pretty",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@the-editor/kernel": "workspace:*",
    "effect": "catalog:",
    "esbuild-wasm": "^0.28.1"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "happy-dom": "^20.10.6",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
