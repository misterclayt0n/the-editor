{
  "name": "@the-editor/monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "node scripts/dev.ts",
    "dev:web": "node scripts/dev.ts web",
    "dev:desktop": "node scripts/dev.ts desktop",
    "typecheck": "turbo run typecheck && tsgo --noEmit --pretty -p scripts/tsconfig.json",
    "test": "turbo run test && vitest run scripts",
    "test:e2e": "turbo run test:e2e",
    "bench": "turbo run bench",
    "lint": "oxlint --ignore-pattern '**/node_modules/**' --ignore-pattern '**/dist/**' --ignore-pattern '**/dist-electron/**' .",
    "lint:fix": "oxlint --ignore-pattern '**/node_modules/**' --ignore-pattern '**/dist/**' --ignore-pattern '**/dist-electron/**' . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "clean": "turbo run clean && rm -rf node_modules .turbo apps/*/dist apps/*/.vite packages/*/dist"
  },
  "dependencies": {
    "effect": "^3.21.2"
  },
  "devDependencies": {
    "@effect/language-service": "^0.86.2",
    "@effect/platform-node": "^0.106.0",
    "@effect/vitest": "^0.29.0",
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.10.13",
    "@types/react": "^19.2.3",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "^7.0.0-dev.20260521.1",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "^40.6.0",
    "mitata": "^1.0.34",
    "oxfmt": "^0.40.0",
    "oxlint": "^1.55.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tsdown": "^0.20.3",
    "turbo": "^2.3.3",
    "typescript": "^5.9.2",
    "vite": "^8.0.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=24.13.1",
    "pnpm": ">=10.33.0"
  },
  "packageManager": "pnpm@10.33.0"
}
