{
  "name": "@the-editor/editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./runtimeClient": {
      "types": "./src/runtimeClient.ts",
      "import": "./dist/runtimeClient.mjs",
      "require": "./dist/runtimeClient.cjs"
    },
    "./ui": {
      "types": "./src/ui.ts",
      "import": "./dist/ui.mjs",
      "require": "./dist/ui.cjs"
    },
    "./themes": {
      "types": "./src/themes.ts",
      "import": "./dist/themes.mjs",
      "require": "./dist/themes.cjs"
    },
    "./workbench": {
      "types": "./src/workbench.ts",
      "import": "./dist/workbench.mjs",
      "require": "./dist/workbench.cjs"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts src/runtimeClient.ts src/editorHost.ts src/disposable.ts src/contributions.ts src/hooks.ts src/commands.ts src/keymaps.ts src/modules.ts src/ui.ts src/themes.ts src/workbench.ts src/diagnostics.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@the-editor/contracts": "workspace:*",
    "@the-editor/runtime-node": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
