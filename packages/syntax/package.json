{
  "name": "@the-editor/syntax",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts --dts --format esm",
    "dev": "tsdown src/index.ts --dts --format esm --watch",
    "typecheck": "tsgo --noEmit --pretty",
    "test": "vitest run test/syntax.test.ts test/query.test.ts test/store.test.ts --passWithNoTests",
    "clean": "rm -rf dist",
    "codegen": "tsx scripts/generate-languages.ts"
  },
  "dependencies": {
    "tree-sitter": "^0.21.1"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "smol-toml": "^1.6.1",
    "tree-sitter-json": "^0.24.8",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@the-editor/grammar-loader": "workspace:*"
  }
}
