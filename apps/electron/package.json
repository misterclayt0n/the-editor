{
  "name": "@the-editor/electron",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main/main.cjs",
  "scripts": {
    "dev": "bun run scripts/dev.mjs",
    "dev:main": "tsdown --watch",
    "dev:renderer": "bun run --filter @the-editor/renderer dev",
    "dev:electron": "bun run scripts/dev-electron.mjs",
    "build": "tsdown && mkdir -p dist/main && cp src/main/preload.cjs dist/main/preload.cjs && bun run --filter @the-editor/renderer build",
    "start": "electron dist/main/main.cjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@the-editor/contracts": "workspace:*",
    "@the-editor/default": "workspace:*",
    "@the-editor/editor": "workspace:*",
    "@the-editor/runtime-node": "workspace:*",
    "electron": "latest"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
