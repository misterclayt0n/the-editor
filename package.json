{
  "name": "@the-editor/monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "oxlint --ignore-pattern '**/node_modules/**' --ignore-pattern '**/dist/**' .",
    "lint:fix": "oxlint --ignore-pattern '**/node_modules/**' --ignore-pattern '**/dist/**' . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "clean": "turbo run clean && rm -rf node_modules .turbo packages/*/dist apps/*/dist apps/*/dist-electron"
  },
  "dependencies": {
    "effect": "^3.21.2"
  },
  "devDependencies": {
    "@effect/language-service": "^0.86.2",
    "@effect/platform-node": "^0.106.0",
    "@effect/vitest": "^0.29.0",
    "@types/node": "^24.10.13",
    "@typescript/native-preview": "^7.0.0-dev.20260521.1",
    "oxfmt": "^0.40.0",
    "oxlint": "^1.55.0",
    "tsdown": "^0.20.3",
    "turbo": "^2.3.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=24.13.1",
    "pnpm": ">=10.33.0"
  },
  "packageManager": "pnpm@10.33.0"
}
