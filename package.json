{
  "name": "the-editor",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/*"
    ],
    "catalog": {
      "@types/node": "^24.10.13",
      "tsdown": "^0.20.3",
      "typescript": "^5.7.3",
      "vitest": "^4.0.0"
    }
  },
  "scripts": {
    "build": "bun --filter @the-editor/contracts build && bun --filter @the-editor/runtime-node build && bun --filter @the-editor/editor build && bun --filter @the-editor/default build && bun run --filter './apps/*' build",
    "typecheck": "bun run --filter './packages/*' --filter './apps/*' typecheck",
    "test": "bun run --filter './packages/*' --filter './apps/*' test"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "bun": "^1.3.9",
    "node": ">=24.13.1"
  },
  "packageManager": "bun@1.3.9"
}
