{
  "name": "@the-editor/editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./completion": {
      "types": "./src/completion.ts",
      "import": "./dist/completion.mjs",
      "require": "./dist/completion.cjs"
    },
    "./ui": {
      "types": "./src/ui.ts",
      "import": "./dist/ui.mjs",
      "require": "./dist/ui.cjs"
    },
    "./input": {
      "types": "./src/input.ts",
      "import": "./dist/input.mjs",
      "require": "./dist/input.cjs"
    },
    "./themes": {
      "types": "./src/themes.ts",
      "import": "./dist/themes.mjs",
      "require": "./dist/themes.cjs"
    },
    "./workbench": {
      "types": "./src/workbench.ts",
      "import": "./dist/workbench.mjs",
      "require": "./dist/workbench.cjs"
    },
    "./gutters": {
      "types": "./src/gutters.ts",
      "import": "./dist/gutters.mjs",
      "require": "./dist/gutters.cjs"
    },
    "./cursorAnchors": {
      "types": "./src/cursorAnchors.ts",
      "import": "./dist/cursorAnchors.mjs",
      "require": "./dist/cursorAnchors.cjs"
    },
    "./markdown": {
      "types": "./src/markdown.ts",
      "import": "./dist/markdown.mjs",
      "require": "./dist/markdown.cjs"
    },
    "./markdownLinks": {
      "types": "./src/markdownLinks.ts",
      "import": "./dist/markdownLinks.mjs",
      "require": "./dist/markdownLinks.cjs"
    },
    "./markdownView": {
      "types": "./src/markdownView.tsx",
      "import": "./dist/markdownView.mjs",
      "require": "./dist/markdownView.cjs"
    },
    "./textSurfaceCanvas": {
      "types": "./src/textSurfaceCanvas.ts",
      "import": "./dist/textSurfaceCanvas.mjs",
      "require": "./dist/textSurfaceCanvas.cjs"
    },
    "./surfaceViewportController": {
      "types": "./src/surfaceViewportController.ts",
      "import": "./dist/surfaceViewportController.mjs",
      "require": "./dist/surfaceViewportController.cjs"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts src/editorHost.ts src/disposable.ts src/contributions.ts src/hooks.ts src/commands.ts src/completion.ts src/keymaps.ts src/input.ts src/stores.ts src/modules.ts src/ui.ts src/themes.ts src/workbench.ts src/gutters.ts src/cursorAnchors.ts src/markdown.ts src/markdownLinks.ts src/markdownView.tsx src/diagnostics.ts src/textSurfaceCanvas.ts src/surfaceViewportController.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@pierre/diffs": "^1.1.22",
    "@the-editor/contracts": "workspace:*",
    "markdown-it": "^14.1.1",
    "react": "^19.2.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "catalog:",
    "@types/react": "^19.2.14",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
