{
  "name": "@the-editor/engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts --dts --format esm",
    "dev": "tsdown src/index.ts --dts --format esm --watch",
    "typecheck": "tsgo --noEmit --pretty",
    "test": "vitest run test/text.test.ts test/transaction.test.ts test/effect.test.ts test/chars.test.ts test/grapheme.test.ts test/columns.test.ts test/line-ending.test.ts test/selection.test.ts test/history.test.ts test/search.test.ts test/match-brackets.test.ts test/surround.test.ts test/comment.test.ts --passWithNoTests",
    "test:stress": "vitest run test/text.stress.test.ts --passWithNoTests",
    "bench": "node --expose-gc --import tsx src/text/bench.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@the-editor/syntax": "workspace:*",
    "effect": "catalog:",
    "graphemer": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tree-sitter-json": "^0.24.8",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
